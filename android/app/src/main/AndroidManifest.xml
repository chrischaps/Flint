<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Require Vulkan support (minSdk 26 also satisfies AAudio requirement) -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:hasCode="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- NativeActivity — built into Android, no Java dependencies needed -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Point to our native library -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="flint_android" />
        </activity>
    </application>

</manifest>
