// Flint Query Language Grammar

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

// Main query structure: the whole input, so anything after the one
// condition (`and ...`, a second clause) is a parse error, not ignored (#687)
query = { SOI ~ resource ~ (where_clause)? ~ EOI }

// One condition alone, as `flint playtest`'s `expect <entity> <condition>`
// asks of one entity (#714)
condition_only = { SOI ~ condition ~ EOI }

// Resources that can be queried
resource = { "entities" | "components" }

// WHERE clause
where_clause = { ^"where" ~ condition }

// Conditions
condition = { field ~ operator ~ value }

// Field path (e.g., "archetype" or "door.locked"; an array's element by
// x, y, z or w: "transform.position.y")
field = @{ identifier ~ ("." ~ identifier)* }
identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Operators
operator = { "==" | "!=" | "contains" | ">=" | "<=" | ">" | "<" }

// Values
value = { string | number | boolean }
string = { "'" ~ string_inner ~ "'" | "\"" ~ string_inner_dq ~ "\"" }
string_inner = @{ (!"'" ~ ANY)* }
string_inner_dq = @{ (!"\"" ~ ANY)* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
boolean = { "true" | "false" }
